.enum                                   ; gameMode: index into GameModeHandlers / ModeScripts
  GM_TITLE                              ; 0: title menu: 1/2 PLAYER GAME A/B (SELECT cycles gameSelect, START starts); demo after a while
  GM_FLOOR_START                        ; 1: set up a floor and show it before play (also after losing a life)
  GM_PLAY                               ; 2: gameplay (also the demo)
  GM_FLOOR_CLEAR                        ; 3: boss beaten: the player walks off, time bonus tally
  GM_GAME_OVER                          ; 4: "1-PLAYER GAME OVER" after the last life
  GM_SYLVIA_SCENE                       ; 5: after floors 2 and 4: "SAVE SYLVIA FROM MR.X", "HELP ME THOMAS!"
  GM_ENDING                             ; 6: after floor 5: CONGRATULATIONS texts, then the next loop (defeatCount+1)
.endenum
.enum                                   ; ppuJob: index into PpuJobLo/Hi (PPU string records written at the next NMI); 0-4 = ppuBuffer
  PPUJOB_SPR_PAL_2_3 = $05              ; 5: sprite palettes 2-3
  PPUJOB_FLOOR_ATTRS                    ; 6: floor screen: attributes, HUD frame and labels, ceiling beam (both nametables)
  PPUJOB_FLOOR_SCENERY                  ; 7: + variant (floor 1: +0, floors 3/5: +1, floors 2/4: +2): ceiling brackets; +0 also the bottom rows
  PPUJOB_STAIRS = $0A                   ; $0A: + walking direction (floorGoesRight): diagonal of 3-tile rows = the stairs at the floor end
  PPUJOB_PALETTE = $0C                  ; $0C: background + sprite palettes 0-1
  PPUJOB_TIME_OVER                      ; $0D: "TIME OVER"
  PPUJOB_PLAYER_FLOOR                   ; $0E: "?PLAYER ?FLOOR" banner (JobPlayerFloor)
  PPUJOB_READY                          ; $0F: "READY"
  PPUJOB_CLEAR_TEXT                     ; $10: clears the TIME OVER / READY lines
  PPUJOB_SYLVIA_ATTRS                   ; $11: Sylvia scene: attributes and its texts
  PPUJOB_HELP_ME                        ; $12: "HELP ME" / "THOMAS"
  PPUJOB_SYLVIA                         ; $13: "SYLVIA"
  PPUJOB_HELP_ME_CLEAR                  ; $14: clears "HELP ME" / "THOMAS" (blinking)
  PPUJOB_SPR_PAL_0                      ; $15
  PPUJOB_SPR_PAL_3                      ; $16
  PPUJOB_TITLE_ATTRS = $18              ; $18: title screen: attributes and the logo rows
  PPUJOB_PALETTE_ALL                    ; $19: all 32 palette bytes
  PPUJOB_SPR_PAL_2                      ; $1A
  PPUJOB_ERASE_PLAYER                   ; $1B: blanks the player's background-tile column when he dies
  PPUJOB_BOSS_PAL                       ; $1C: + floor: $1C-$20, sprite palette 2/3 of the floor's boss (floors 1 and 3: empty ppuBuffer)
  PPUJOB_CONGRATULATIONS = $21          ; $21: ending: "CONGRATULATIONS" / "THOMAS AND SYLVIA" + picture
  PPUJOB_ENDING_TEXT                    ; $22: ending: "BUT THEIR HAPPINESS" / "DOES NOT CONTINUE LONG"
  PPUJOB_FLOOR_ROWS                     ; $23: floor rows 22-29 of both nametables
  PPUJOB_PLAYER = $25                   ; $25: $25-$4E: player body frames, drawn as background tiles at the screen centre
.endenum
