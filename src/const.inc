APU_CONST              = %00010000      ; constant volume (low 4 bits)
APU_SILENT             = APU_DUTY_50 | APU_CONST ; constant volume 0
APU_LEN_SHIFT          = 3              ; length counter index in $4003/$4007/$400B/$400F
SWEEP_ON               = %10000000
SWEEP_PERIOD_SHIFT     = 4
