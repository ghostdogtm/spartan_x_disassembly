; Constants. Generated by tools/disasm.py from tools/labels/const.txt

PPUCTRL_NT_MASK        = %00000011      ; nametable select
PPUCTRL_INC32          = %00000100      ; PPUDATA address +32 (vertical)
PPUCTRL_SPR_1000       = %00001000      ; sprite patterns at $1000
PPUCTRL_BG_1000        = %00010000      ; background patterns at $1000
PPUCTRL_NMI            = %10000000      ; NMI at vblank
PPUCTRL_GAME           = PPUCTRL_NMI | PPUCTRL_BG_1000
PPUMASK_BG_LEFT        = %00000010      ; show background in the left 8 pixels
PPUMASK_SPR_LEFT       = %00000100      ; show sprites in the left 8 pixels
PPUMASK_SHOW_BG        = %00001000
PPUMASK_SHOW_SPR       = %00010000
PPUMASK_OFF            = PPUMASK_BG_LEFT | PPUMASK_SPR_LEFT ; rendering off
PPUMASK_ON             = PPUMASK_SHOW_BG | PPUMASK_SHOW_SPR | PPUMASK_BG_LEFT ; ORed in while displayOn
PPUSTATUS_SPR0         = %01000000      ; sprite 0 hit
NAMETABLE0             = $2000
NAMETABLE1             = $2400
ATTR_OFFSET            = $3C0           ; attribute table inside a nametable
TILE_BLANK             = $FC            ; empty background tile
OAM_HIDE_Y             = $F8            ; sprite Y below the screen
SPRITE_BYTES           = 4              ; one OAM record
TILE_PX                = 8              ; one tile / sprite is 8 pixels wide
SPR_BEHIND             = %00100000      ; sprite attribute: behind the background
SPR_FLIP_H             = %01000000
SPR_FLIP_V             = %10000000
.struct Sprite                          ; one OAM record (oamBuffer, sprListA/B/C)
  ypos                 .byte
  tile                 .byte
  attr                 .byte
  xpos                 .byte
.endstruct
SNDCHN_TONES           = %00001111      ; square 1+2, triangle, noise
