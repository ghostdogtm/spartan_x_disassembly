BOSS4_DOUBLE_WAIT      = $30            ; bossWaitTimer after each double
OBJ_SLOTS              = 7              ; object slots 0-6 (enemies, boss, player)
FALL_END_Y             = $D8            ; a knocked-out object is freed when objY reaches this
KNIFE_RIGHT_BIT        = KNIFE_FLYING_RIGHT ^ KNIFE_FLYING ; knifeState bit: flying right
KNIFE_TILE             = $0A            ; sprite tile of a knife
WALK_CARRY_TIME        = 6              ; walkCarryTimer on each scroll step
SCROLL_ACTIVE_TIME     = $1A            ; scrollActiveTimer on each spawnStep change
SPAWN_STEP_PX          = $18            ; scroll pixels per spawnStep (spawnStepFine)
APU_CH_SQ2             = SQ2_VOL - SQ1_VOL ; SetChannelFreq: register offset of a channel
APU_CH_TRI             = TRI_LINEAR - SQ1_VOL
PPUREC_HEAD            = 3              ; ppuBuffer record: address hi, lo, length, then the bytes (0 ends the buffer)
FLOOR_TIME_DIGITS      = 4
FLOOR_TIME_PPU         = NAMETABLE0+$DA
SCORE_DIGITS           = 7              ; score / topScores (two tables: game A, game B)
SCORE_SHOWN            = 6              ; score+1..+6 are printed (the top digit is never shown)
EXTRA_LIFE_DIGIT       = 5              ; score+2 (ten thousands) reaching this gives the extra life: 50000 (Mesen: score+2 forced to 5 -> lives +1, extraLifeGiven set)
LIVES_PPU              = NAMETABLE0+$F1
HEALTH_PER_TILE        = 8              ; health bar: one tile per 8 points
HEALTH_BAR_TILES       = HEALTH_FULL / HEALTH_PER_TILE
PLAYER_BAR_PPU         = NAMETABLE0+$A8
BOSS_BAR_PPU           = NAMETABLE0+$E8
TILE_BAR_FULL          = $FD            ; full health tile; also the bar end sprite of the boss bar
TILE_BAR_END_PLAYER    = $FE            ; bar end sprite of the player bar
BAR_END_X              = $38            ; X of the bar end sprite for an empty bar
BAR_END_Y              = $17            ; Y of the first bar end sprite (-$10, PutBarEndSprite adds $10 per bar)
BAR_END_Y_STEP         = $10
BOSS_HEAL_PERIOD       = $0D            ; bossHealTimer: bossHealth + 1 every this many slow ticks below HEALTH_FULL
FLOOR_MARKER_BLINK     = 2              ; floorMarkerTimer between blinks
NT_ROW_TILES           = 32             ; tiles per nametable row
NT_SIZE                = $400           ; one nametable with its attributes
OBJMODE_POT_BROKEN     = 1              ; a pot that hit the floor
OBJMODE_SMOKE          = 2              ; ObjAppear / ObjVanish smoke (floor 4 boss)
OBJMODE_BREATH         = 3              ; the dragon breathes fire
OBJMODE_RISE           = 5              ; the dragon rises from its ball
OBJMODE_VANISH         = 6              ; the dragon vanishes
ONSCREEN_X_MIN         = $28            ; an object counts as well on screen between these objX
ONSCREEN_X_MAX         = $D8
SCREEN_EDGE            = 8              ; a floor 4 flyer point within 8 pixels of the screen edge is skipped
FLOOR2_EVENTS_PAGE     = 3              ; Floor2Events until scrollPage reaches this
FLOOR4_EVENTS_PAGE     = 4              ; Floor4Events until the player (objWorldXHi+6) reaches this page
DROP_LAND_Y            = $AA            ; a dropped dragon ball or pot lands at this objY
BURST_Y                = $78            ; a floor 2 burst ball bursts at this objY
POINT_BOX_X            = 3              ; PointHitBox: box of a shot around (ram_000A, ram_000B): left = x + this
POINT_BOX_W            = 2              ; ... its width
POINT_BOX_Y            = 4              ; ... ptr_03 = y + this
POINT_BOX_H            = 3              ; ... ptr_01 = ptr_03 + this
HOP_BOX_TOP            = $20            ; SmallEnemyContact: box top below objY of the hopping enemy (its feet)
HOP_BOX_H              = 8
HOP_BOX_HALF           = 4              ; box = objX +- this
SPARK_X_BACK           = 4              ; a hit on the player: spark X = objX+6 - this
SPARK_Y_DROP           = 4              ; a hit by a falling object: spark Y = objY + this
HOP_SPARK_Y            = $98            ; spark Y of a hop hitting the crouching player
FRAGMENT_DAMAGE_B      = $19            ; hitDamage of a fragment (game B)
FRAGMENT_DAMAGE_A      = $13            ; ... game A
HOP_RISE_BASE          = $1E            ; HopYRise / HopYLand: objY = hopStartY - this
HOP_FALL_BASE          = $28            ; HopYFall
BOSS_STEP_STRIKE       = 2
BOSS_STEP_WINDUP       = 3              ; start of a counter-attack, floor 4 cast, floor 5 attack or jump
TIME_BONUS_REPEAT      = 7              ; TimeBonus: floorTime steps per call (loop counts down to -1)
RNG_BYTES              = 8              ; rngState
FLYER_POINTS           = 4              ; floor 4 flyer start points (slots 7-10)
GAME_OVER_TEXT_LEN     = $21            ; PPU record copied to ppuBufLen (GameOverText)
PALETTE_TEMPLATE_LEN   = $25
EFFECT_SLOTS           = 3              ; effectTile / effectTimer / fragments: 3 slots each
ACTION_LOCK_TIME       = $0A            ; use A85F ACTION_LOCK_TIME ; actionLockTimer: attack pose time
FLOOR_START_TIME       = 8              ; use 8745 FLOOR_START_TIME
TITLE_IDLE_TIME        = $38            ; use 843B TITLE_IDLE_TIME ; modeWaitTimer: title idle before the demo
DEATH_WAIT_TIME        = $10            ; use B25B DEATH_WAIT_TIME ; modeWaitTimer after the player died
SCENE_STEP_TIME        = 5              ; use 8970 8BFB A703 SCENE_STEP_TIME ; sceneTimer: short floor-clear / scene steps
SCENE_PAUSE_TIME       = $18            ; use 8BB6 SCENE_PAUSE_TIME ; sceneTimer: long pause
SYLVIA_WAIT_TIME       = $2C            ; use 894D SYLVIA_WAIT_TIME ; timersSlow+4 in the Sylvia scene
ENDING_GAP_TIME        = $10            ; use 8CEF ENDING_GAP_TIME ; spawnGapTimer reused by the ending
